# Example only: this file does NOT auto-load into Spring Boot.
# Set these as process environment variables or through a local secret manager.
# Never use production credentials in a developer workstation or Android app.
# The SSL factory uses the JDK trust store and verifies the Neon endpoint hostname.
# Never lower sslmode to require/disable to bypass certificate errors.
SPRING_PROFILES_ACTIVE=neon
NEON_JDBC_URL=jdbc:postgresql://<NEON_DEVELOPMENT_HOST>:5432/agenda_barber?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
NEON_DB_USERNAME=agenda_app_dev
NEON_DB_PASSWORD=<INJECT_SECURELY_AT_RUNTIME>

# Start from D:\appeber: mvn -f backend/pom.xml spring-boot:run
# The F01-01D SELECT 1 check is not implemented in this preparation step.
# Keep the real JDBC URL, password and environment-specific settings outside Git.
